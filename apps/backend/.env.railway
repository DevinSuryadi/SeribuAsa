# ============================================
# RAILWAY (BACKEND) ENVIRONMENT VARIABLES
# ============================================
# Copy these to Railway Dashboard → Project → Variables

# ============================================
# 1. APPLICATION CONFIGURATION
# ============================================
APP_NAME=NutriGuard API
APP_VERSION=1.0.0
API_VERSION=v1
LOG_LEVEL=INFO

# ============================================
# 2. CORS - FRONTEND URLS (PENTING!)
# ============================================
# Tambahkan URL Vercel frontend setelah deploy
# Pisahkan dengan koma
CORS_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:5173,http://localhost:5174

# ============================================
# 3. DATABASE - SUPABASE POSTGRESQL
# ============================================
# Dapatkan dari Supabase Dashboard → Project Settings → Database → Connection String
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ============================================
# 4. SUPABASE AUTH
# ============================================
# Dapatkan dari Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
SUPABASE_SERVICE_KEY=[YOUR-SERVICE-ROLE-KEY]

# ============================================
# 5. JWT SECURITY
# ============================================
# BUAT KEY YANG SANGAT RAHASIA DAN PANJANG (min 32 karakter)
# Gunakan: https://generate-secret.vercel.app/32
JWT_SECRET_KEY=CHANGE-THIS-TO-A-VERY-LONG-RANDOM-STRING-MINIMUM-32-CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================
# 6. MIDTRANS PAYMENT GATEWAY
# ============================================
# Dapatkan dari Midtrans Dashboard → Settings → Access Keys
MIDTRANS_SERVER_KEY=[YOUR-SERVER-KEY]
MIDTRANS_CLIENT_KEY=[YOUR-CLIENT-KEY]
MIDTRANS_IS_PRODUCTION=false

# ============================================
# 7. FILE STORAGE
# ============================================
STORAGE_BUCKET_NAME=nutriguard-uploads
MAX_FILE_SIZE_MB=5
