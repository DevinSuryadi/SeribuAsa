{
  "name": "nutri-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Platform Donasi Pangan Berbasis AI untuk Mengatasi Food Insecurity di Indonesia",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.9.14"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.2.4",
  "dependencies": {
    "@radix-ui/react-toast": "^1.2.15",
    "@supabase/supabase-js": "^2.100.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "lucide-react": "^1.7.0",
    "react-helmet-async": "^3.0.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0"
  }
}
