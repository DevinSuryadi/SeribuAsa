# Dependencies and package-manager caches
**/node_modules/
.pnp
.pnp.*
**/.npm/
**/.yarn/
**/.pnpm-store/

# Environment files and local secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Frontend build and tool output
**/dist/
**/dist-ssr/
**/build/
**/.next/
**/.nuxt/
**/.turbo/
**/.vite/
**/*.tsbuildinfo

# Tests and coverage
**/coverage/
**/htmlcov/
**/playwright-report/
**/test-results/
**/blob-report/
**/.nyc_output/
**/.coverage
**/.coverage.*
**/coverage.xml
**/junit.xml
**/lint-results.json

# Python caches, environments, and packaging output
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.hypothesis/
**/.tox/
**/.nox/
**/.venv/
**/venv/
**/env/
**/ENV/
**/*.egg-info/
**/.eggs/
**/*.egg
**/*.whl

# Logs and temporary files
**/*.log
**/*.tmp
**/*.temp
**/*.bak
**/*.swp
**/*.swo
**/*~

# IDE and operating-system metadata
**/.vscode/
**/.idea/
**/.DS_Store
**/Thumbs.db
**/Desktop.ini

# Local tooling caches
**/.cache/
**/.eslintcache
**/.stylelintcache
**/.parcel-cache/
**/.sass-cache/
